-- Clean Stonks Script with PlayerData Features
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "Stonks Pro",
   Icon = "trending-up",
   LoadingTitle = "Stonks",
   LoadingSubtitle = "676767",
   Theme = "Default",
   DisableRayfieldPrompts = false,
   DisableBuildWarnings = false,
   ConfigurationSaving = {
      Enabled = true,
      FolderName = "StonksPro",
      FileName = "StonksConfig"
   },
   Discord = { Enabled = false },
   KeySystem = false
})

-- Variables
local autoSellEnabled = false
local autoClaimDividends = false
local gameID = 92565026516505
local sellAmount = 10
local sellDelay = 0.1

-- Helper functions
local function getStocksService()
   return game:GetService("ReplicatedStorage"):WaitForChild("Packages"):WaitForChild("_Index"):WaitForChild("sleitnick_knit@1.7.0"):WaitForChild("knit"):WaitForChild("Services"):WaitForChild("Stocks"):WaitForChild("RF")
end

local function getPlayerDataService()
   return game:GetService("ReplicatedStorage"):WaitForChild("Packages"):WaitForChild("_Index"):WaitForChild("sleitnick_knit@1.7.0"):WaitForChild("knit"):WaitForChild("Services"):WaitForChild("PlayerData"):WaitForChild("RF")
end

-- Stock Functions
local function marketSellPoints(id, amount)
   local args = {id, amount}
   getStocksService():WaitForChild("MarketSellPoints"):InvokeServer(unpack(args))
end

local function marketBuyPoints(id, amount)
   local args = {id, amount}
   getStocksService():WaitForChild("MarketBuyPoints"):InvokeServer(unpack(args))
end

local function claimAllDividends()
   getStocksService():WaitForChild("ClaimAllDividends"):InvokeServer()
end

-- PlayerData Functions
local function getClientData()
   return getPlayerDataService():WaitForChild("GetClientData"):InvokeServer()
end

local function getPortfolioData()
   return getPlayerDataService():WaitForChild("GetPortfolioData"):InvokeServer()
end

-- Auto Sell Loop
local function autoSellLoop()
   while autoSellEnabled do
       pcall(function()
           marketSellPoints(gameID, sellAmount)
       end)
       task.wait(sellDelay)
   end
end

-- Auto Claim Dividends Loop
local function autoClaimDividendsLoop()
   while autoClaimDividends do
       pcall(function()
           claimAllDividends()
       end)
       task.wait(5)
   end
end

-- 📊 Trading Tab
local TradingTab = Window:CreateTab("Trading", "shopping-cart")

TradingTab:CreateSection("Market Sell Points")

TradingTab:CreateInput({
   Name = "Game ID",
   CurrentValue = "92565026516505",
   PlaceholderText = "Enter Game ID",
   RemoveTextAfterFocusLost = false,
   Callback = function(Value)
       gameID = tonumber(Value)
   end,
})

TradingTab:CreateInput({
   Name = "Sell Amount",
   CurrentValue = "10",
   PlaceholderText = "Amount to sell",
   RemoveTextAfterFocusLost = false,
   Callback = function(Value)
       sellAmount = tonumber(Value)
   end,
})

TradingTab:CreateSlider({
   Name = "Sell Speed",
   Range = {0, 1},
   Increment = 0.05,
   Suffix = "s",
   CurrentValue = 0.1,
   Callback = function(Value)
       sellDelay = Value
   end,
})

TradingTab:CreateToggle({
   Name = "Auto Sell Points",
   CurrentValue = false,
   Callback = function(Value)
       autoSellEnabled = Value
       if Value then
           task.spawn(autoSellLoop)
           Rayfield:Notify({
               Title = "Auto Sell",
               Content = "Started selling " .. sellAmount .. " from ID: " .. gameID,
               Duration = 3,
               Image = "play-circle"
           })
       end
   end,
})

TradingTab:CreateButton({
   Name = "Sell Once",
   Callback = function()
       pcall(function()
           marketSellPoints(gameID, sellAmount)
           Rayfield:Notify({
               Title = "Sold!",
               Content = "Sold " .. sellAmount .. " from ID: " .. gameID,
               Duration = 3,
               Image = "check-circle"
           })
       end)
   end,
})

TradingTab:CreateButton({
   Name = "Buy Points",
   Callback = function()
       pcall(function()
           marketBuyPoints(gameID, sellAmount)
           Rayfield:Notify({
               Title = "Bought!",
               Content = "Bought " .. sellAmount .. " from ID: " .. gameID,
               Duration = 3,
               Image = "check-circle"
           })
       end)
   end,
})


PortfolioTab:CreateSection("Data Display")
local BalanceLabel = PortfolioTab:CreateLabel("💰 Balance: Loading...")
local RobuxLabel = PortfolioTab:CreateLabel("💎 Robux: Loading...")
local StocksLabel = PortfolioTab:CreateLabel("📊 Stocks: Loading...")

-- Auto-update portfolio data
task.spawn(function()
   while task.wait(3) do
       pcall(function()
           local clientData = getClientData()
           if clientData then
               -- These will depend on the actual data structure
               -- Adjust the keys based on what GetClientData returns
               if clientData.Balance then
                   BalanceLabel:Set("💰 Balance: " .. tostring(clientData.Balance))
               end
               if clientData.Robux then
                   RobuxLabel:Set("💎 Robux: " .. tostring(clientData.Robux))
               end
           end
           
           local portfolioData = getPortfolioData()
           if portfolioData then
               local stockCount = 0
               if type(portfolioData) == "table" then
                   for _ in pairs(portfolioData) do
                       stockCount = stockCount + 1
                   end
               end
               StocksLabel:Set("📊 Stocks Owned: " .. stockCount)
           end
       end)
   end
end)


})

-- ================== DRILL EXPANDER TAB ==================
local DrillTab = Window:CreateTab("Drill Expander")

local drillZones = {}

local function refreshDrillZones()
    drillZones = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == "DrillZone" and obj:IsA("BasePart") then
            table.insert(drillZones, obj)
        end
    end
end

refreshDrillZones()

local currentX, currentY, currentZ = 27.3, 22.1, 2
local currentTransparency = 0.8

if #drillZones > 0 then
    local first = drillZones[1]
    currentX, currentY, currentZ = first.Size.X, first.Size.Y, first.Size.Z
    currentTransparency = first.Transparency
end

local function updateDrillProperties()
    for _, zone in ipairs(drillZones) do
        if zone and zone.Parent then
            zone.Size = Vector3.new(currentX, currentY, currentZ)
            zone.Transparency = currentTransparency
        end
    end
end

DrillTab:CreateParagraph({ 
    Title = "Drill Controls", 
    Content = "Currently found " .. #drillZones .. " DrillZone(s)" 
})

DrillTab:CreateButton({ 
    Name = "Refresh Drill Zones", 
    Callback = function()
        refreshDrillZones()
        Rayfield:Notify({ Title = "Refreshed", Content = #drillZones .. " DrillZones found.", Duration = 3 })
    end
})

DrillTab:CreateSlider({ Name = "X Size", Range = {0.1, 500}, Increment = 0.1, CurrentValue = currentX, Callback = function(v) currentX = v updateDrillProperties() end })
DrillTab:CreateSlider({ Name = "Y Size", Range = {0.1, 500}, Increment = 0.1, CurrentValue = currentY, Callback = function(v) currentY = v updateDrillProperties() end })
DrillTab:CreateSlider({ Name = "Z Size", Range = {0.1, 500}, Increment = 0.1, CurrentValue = currentZ, Callback = function(v) currentZ = v updateDrillProperties() end })
DrillTab:CreateSlider({ Name = "Transparency", Range = {0, 1}, Increment = 0.05, CurrentValue = currentTransparency, Callback = function(v) currentTransparency = v updateDrillProperties() end })

DrillTab:CreateButton({
    Name = "Reset to Default",
    Callback = function()
        currentX, currentY, currentZ, currentTransparency = 27.3, 22.1, 2, 0.8
        updateDrillProperties()
        Rayfield:Notify({ Title = "Reset", Content = "Drills restored to default.", Duration = 3 })
    end,
})


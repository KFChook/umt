-- ================== OPTIMIZED ORE ESP ==================
local oreAdornments = {}
local oreESPEnabled = false
local showTracers = false
local maxEspDistance = 200

local camera = Workspace.CurrentCamera
local rootPart = nil

-- Throttling for much better FPS (30 updates per second)
local ESP_UPDATE_RATE = 1/30
local lastEspUpdate = 0

local function addOreESP(part)
    if not part:IsA("BasePart") or oreAdornments[part] then return end

    local box = Instance.new("BoxHandleAdornment")
    box.Adornee = part
    box.Size = part.Size + Vector3.new(0.2, 0.2, 0.2)
    box.Color3 = part.Color
    box.Transparency = 0.4
    box.ZIndex = 5
    box.AlwaysOnTop = true
    box.Visible = false
    box.Parent = camera

    local tracer = Drawing.new("Line")
    tracer.Color = part.Color
    tracer.Thickness = 1.5
    tracer.Transparency = 0.85
    tracer.Visible = false

    oreAdornments[part] = { 
        box = box, 
        tracer = tracer
    }
end

local function removeOreESP(part)
    local data = oreAdornments[part]
    if data then
        if data.box then data.box:Destroy() end
        if data.tracer then data.tracer:Remove() end
        oreAdornments[part] = nil
    end
end

local function setupOreESP()
    local placedOre = Workspace:FindFirstChild("PlacedOre")
    if not placedOre then
        placedOre = Workspace:WaitForChild("PlacedOre", 10)
    end

    if placedOre then
        for _, desc in ipairs(placedOre:GetDescendants()) do
            if desc:IsA("BasePart") then
                addOreESP(desc)
            end
        end

        placedOre.DescendantAdded:Connect(addOreESP)
        placedOre.DescendantRemoving:Connect(removeOreESP)
    end
end

-- Optimized ESP Render Loop
local espConnection = RunService.RenderStepped:Connect(function()
    if not oreESPEnabled then return end

    local character = LocalPlayer.Character
    rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end

    local now = tick()
    if now - lastEspUpdate < ESP_UPDATE_RATE then return end
    lastEspUpdate = now

    for part, data in pairs(oreAdornments) do
        if not (part and part.Parent) then
            removeOreESP(part)
            continue
        end

        local distance = (rootPart.Position - part.Position).Magnitude
        local inRange = distance <= maxEspDistance

        if data.box then
            data.box.Visible = inRange
        end

        if showTracers and inRange and data.tracer then
            local screenPos, onScreen = camera:WorldToViewportPoint(part.Position)
            if onScreen then
                data.tracer.From = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
                data.tracer.To = Vector2.new(screenPos.X, screenPos.Y)
                data.tracer.Visible = true
            else
                data.tracer.Visible = false
            end
        else
            if data.tracer then 
                data.tracer.Visible = false 
            end
        end
    end
end)

setupOreESP()


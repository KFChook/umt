                                            and clientSubFolder.Unloader1:FindFirstChild("CargoVolume") 
                                            or clientSubFolder:FindFirstChild("CargoVolume", true)
                                    end
                                end
                            end
                            
                            if cargoPrompt and positionCargoVolume then 
                                break 
                            end
                        end
                    end
                end
            end

